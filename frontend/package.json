  "description": "AI School - 智能学习辅导平台前端",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write src/",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "dayjs": "^1.11.0",
    "highlight.js": "^11.0.0",
    "katex": "^0.16.9",
    "lucide-vue-next": "^1.0.0",
    "markdown-it": "^14.0.0",
    "markdown-it-katex": "^2.0.3",
    "pinia": "^2.1.0",
    "vue": "^3.4.0",
    "vue-router": "^4.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "autoprefixer": "^10.0.0",
    "postcss": "^8.0.0",
    "tailwindcss": "^3.3.0",
    "typescript": "~5.3.0",
    "unplugin-auto-import": "^0.17.0",
    "vite": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
